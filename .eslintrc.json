{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "n/no-missing-import": "off",
    "n/no-unsupported-features/es-syntax": "off"
  }
}
